{
  "name": "quantic-glide-aura-career",
  "version": "1.3.4",
  "description": "Quantic Glide with integrated AURA Career",
  "main": "src/bootstrap.cjs",
  "author": "Quantic",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/bootstrap.cjs && node --check src/main.cjs && node --check src/preload.cjs && node --check src/security/ipc-firewall.cjs && node --check src/core/internal-state.cjs && node --check src/services/career-agent.cjs && node --check src/services/sidestage.cjs && node --check src/services/sidestage-manager.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.quantic.glide.aura.career",
    "productName": "Quantic Glide AURA Career",
    "asar": true,
    "files": [
      "src/**/*",
      "career-agent/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quantic Glide AURA Career",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "artifactName": "Quantic-Glide-AURA-Career-Setup-v1.3.4.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  }
}
