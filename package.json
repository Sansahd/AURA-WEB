{
  "name": "gekko-browser-aura-career",
  "version": "2.4.0-beta.13",
  "description": "GEKKO Browser with integrated AURA Career",
  "main": "src/bootstrap.cjs",
  "author": "Quantic",
  "license": "MIT",
  "scripts": {
    "start": "npm run build:icons && electron .",
    "check": "node --check src/bootstrap.cjs && node --check src/main.cjs && node --check src/preload.cjs && node --check src/web-preload.cjs && node --check src/renderer/renderer.js && node --check src/renderer/site-cache.js && node --check src/services/youtube-guard.cjs && node --check src/services/youtube-direct.cjs && node --check src/services/extensions.cjs && node --check src/services/sync-vault.cjs && node --check src/services/cookie-consent.cjs && node --check src/services/shields.cjs && node --check src/services/career-agent.cjs && npm test",
    "dist": "npm run build:icons && electron-builder --win --x64 --publish never",
    "test": "node --test test/*.test.cjs",
    "smoke:ui": "node scripts/gekko-layout-smoke.cjs",
    "build:icons": "node scripts/build-gekko-icons.cjs"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "26.15.3",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "com.quantic.gekko.browser",
    "productName": "GEKKO Browser",
    "asar": true,
    "files": [
      "src/**/*",
      "career-agent/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/gekko.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GEKKO Browser",
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "artifactName": "GEKKO-Setup.${ext}",
      "installerIcon": "build/gekko.ico",
      "uninstallerIcon": "build/gekko.ico",
      "installerHeaderIcon": "build/gekko.ico"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "src",
        "to": "quantic-ui",
        "filter": [
          "renderer/**/*",
          "assets/**/*"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "youtubei.js": "18.1.0",
    "@ghostery/adblocker": "2.18.2",
    "@ghostery/adblocker-electron": "2.18.2"
  }
}
